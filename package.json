{
  "name": "owl",
  "version": "0.1.9",
  "private": true,
  "license": "Apache-2.0",
  "description": "A private, exact-address send confirmation for Thunderbird.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "node --test test/*.test.js",
    "test:ui": "playwright test",
    "check": "bun run format:check && bun run lint && bun run test && bun run build && bun run test:ui",
    "build": "python3 scripts/build.py"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "linkedom": "0.18.13",
    "prettier": "3.9.10"
  }
}
